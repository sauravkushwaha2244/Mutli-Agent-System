# OpenRouter API Key (Required for extraction, clustering, and synthesis)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API Key (Optional search provider, fallback to OpenRouter Perplexity)
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase Configuration (Optional for research history & persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_anon_key_here

# Model Configuration
OPENROUTER_CHEAP_MODEL=google/gemini-2.5-flash   # Steps 2 & 3 (claim extraction & clustering)
OPENROUTER_STRONG_MODEL=openai/gpt-4o-mini       # Step 4 (report synthesis)

# Server Configuration
FLASK_DEBUG=false
